# Mamachi environment variables.
#
# Every variable here is OPTIONAL. The macOS app injects the runtime ones into
# the daemon it spawns, reading secrets from the macOS Keychain rather than from
# a file. You only need this when you run the daemon directly:
#
#   bun run daemon
#   bun run demo
#
# Copy to `.env` (git-ignored) and uncomment what you need.
# Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Daemon runtime — packages/core/src/daemon.ts
# ---------------------------------------------------------------------------

# Loopback TCP port for the IPC WebSocket server. 0 = ephemeral (what the app
# uses). Must parse as an integer in 0..65535 or the daemon refuses to start.
# MAMACHI_PORT=47821

# SQLite file holding the event log, artifacts, memories, and voice briefs.
# Resolved against the working directory; the parent directory is created.
# The shipped app uses ~/Library/Application Support/Mamachi/state.sqlite
# MAMACHI_STATE_PATH=.mamachi/demo.sqlite

# Where to publish the connection descriptor {version,pid,port,token,workspace}
# (0600 file, 0700 directory). Unset means no descriptor is written, and the
# VS Code extension has no way to find or authenticate to the daemon.
# MAMACHI_CONNECTION_PATH=

# Initial repository the daemon targets. Default: the process working directory.
# MAMACHI_WORKSPACE=

# Coding backend to start with: omp | codex | claude.
# An unrecognized value silently falls back to the default (omp).
# MAMACHI_CODING_BACKEND=omp

# Primary coding model pattern. Empty means "let the backend choose".
# MAMACHI_CODING_MODEL=

# Model for the passive observer. Defaults to RuntimeSettings.fastModel.
# NOTE: when set, this permanently overrides the fast model chosen in Settings.
# MAMACHI_OBSERVER_MODEL=

# Explicit paths to the external coding CLIs. When set, the path must exist —
# the resolver does NOT fall back to PATH discovery if it does not.
# MAMACHI_CODEX_PATH=
# MAMACHI_CLAUDE_PATH=

# ---------------------------------------------------------------------------
# Secrets — never commit these
# ---------------------------------------------------------------------------

# Bearer token required on ws://127.0.0.1:<port>/ws. Default: a fresh UUIDv7
# per launch, echoed on stdout in the `mamachi.ready` line.
# MAMACHI_TOKEN=

# AES-256-GCM key for sensitive SQLite columns. Base64 of EXACTLY 32 bytes:
#   openssl rand -base64 32
# Unset means sensitive fields are stored as PLAINTEXT. The macOS app always
# supplies a Keychain-backed key; a bare `bun run daemon` does not.
# MAMACHI_ENCRYPTION_KEY=

# Provider keys. Optional for coding (the CLIs use their own logins), required
# for voice: OpenAI for the realtime engine, both for the cascade engine.
# The daemon deletes all of these from process.env after reading them, so
# spawned coding CLIs cannot inherit them.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MAMACHI_ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# macOS app — development overrides
# ---------------------------------------------------------------------------

# Repository root. Default: a 12-level upward search for a package.json
# named "mamachi".
# MAMACHI_PROJECT_ROOT=

# Run against a checkout-built daemon instead of the one inside the bundle.
# Must be executable, or app launch fails.
# MAMACHI_DAEMON_PATH=

# ---------------------------------------------------------------------------
# Build — apps/macos/build-app.sh
# ---------------------------------------------------------------------------

# MAMACHI_APP_OUTPUT=apps/macos/dist/Mamachi.app

# auto        pick a Developer ID, then an Apple Development identity, else
#             warn and ad-hoc sign
# adhoc       always ad-hoc sign (rebuilds re-prompt for Keychain access)
# none        do not sign
# developer-id  require MAMACHI_SIGN_IDENTITY
# MAMACHI_SIGN_MODE=auto
# MAMACHI_SIGN_IDENTITY=

# Notarization. Requires a Developer ID identity and a stored notarytool
# Keychain profile; the script preflights both.
# MAMACHI_NOTARIZE=0
# MAMACHI_NOTARY_PROFILE=

# Written into runtime/daemon-version.json. Does NOT rewrite the app bundle
# version, which is fixed in apps/macos/Resources/Info.plist.
# MAMACHI_VERSION=0.1.0

# Extra entitlements for the app binary (the daemon binary always gets
# apps/macos/Resources/Daemon.entitlements).
# MAMACHI_ENTITLEMENTS=
# MAMACHI_DAEMON_ENTITLEMENTS=apps/macos/Resources/Daemon.entitlements

# Bun used at build time. Default: whatever `command -v bun` finds.
# MAMACHI_BUILD_BUN=

# ---------------------------------------------------------------------------
# macOS snapshot tests — write rendered PNGs to disk when set
# ---------------------------------------------------------------------------

# MAMACHI_SNAPSHOT_PATH=
# MAMACHI_LONG_SNAPSHOT_PATH=
# MAMACHI_SETTINGS_SNAPSHOT_PATH=
